// kate: syntax C;
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include "zmk-helpers/helper.h"


//Обьявление Unicode
ZMK_UNICODE_SINGLE(my_skobka_ob_o, N0, N0, N2, N8)         //     (
ZMK_UNICODE_SINGLE(my_skobka_ob_z, N0, N0, N2, N9)         //     )
ZMK_UNICODE_SINGLE(my_skobka_kv_o, N0, N0, N5, B)          //     [
ZMK_UNICODE_SINGLE(my_skobka_kv_z, N0, N0, N5, D)          //     ]
ZMK_UNICODE_SINGLE(my_skobka_f_o, N0, N0, N7, B)           //     {
ZMK_UNICODE_SINGLE(my_skobka_f_z, N0, N0, N7, D)           //     }

ZMK_UNICODE_SINGLE(my_zpt, N0, N0, N2, C)                  //     ,
ZMK_UNICODE_SINGLE(my_TchK, N0, N0, N2, E)                 //     .
ZMK_UNICODE_SINGLE(my_vopr, N0, N0, N3, F)                 //     ?
ZMK_UNICODE_SINGLE(my_voskl, N0, N0, N2, N1)               //     !

ZMK_UNICODE_SINGLE(my_1kov, N0, N0, N2, N7)                //     '
ZMK_UNICODE_SINGLE(my_2kov, N0, N0, N2, N2)                //     "



/ {
    combos {
        compatible = "zmk,combos";

//===Скобки=======================
        combo_skobka_ob_o {                            //    (
            timeout-ms = <30>;
            key-positions = <4 5>;
            bindings = <&my_skobka_ob_o>;
            layers = <0>;
            require-prior-idle-ms = <150>;
        };
        combo_skobka_ob_z {                            //     )
            timeout-ms = <30>;
            key-positions = <6 7>;
            bindings = <&my_skobka_ob_z>;
            layers = <0>;
            require-prior-idle-ms = <150>;
        };
        combo_skobka_kv_o {                            //     [
            timeout-ms = <30>;
            key-positions = <16 17>;
            bindings = <&my_skobka_kv_o>;
            layers = <0>;
            require-prior-idle-ms = <150>;
        };
        combo_skobka_kv_z {                            //     ]
            timeout-ms = <30>;
            key-positions = <18 19>;
            bindings = <&my_skobka_kv_z>;
            layers = <0>;
            require-prior-idle-ms = <150>;
        };
        combo_skobka_f_o {                            //     {
            timeout-ms = <30>;
            key-positions = <28 29>;
            bindings = <&my_skobka_f_o>;
            layers = <0>;
            require-prior-idle-ms = <150>;
        };
        combo_skobka_f_z {                            //     }
            timeout-ms = <30>;
            key-positions = <30 31>;
            bindings = <&my_skobka_f_z>;
            layers = <0>;
            require-prior-idle-ms = <150>;
        };
//===Препинание=====================
        combo_zpt {                                   //     ,
            timeout-ms = <30>;
            key-positions = <19 20>;
            bindings = <&my_zpt>;
            layers = <0>;
            require-prior-idle-ms = <150>;
        };
        combo_TchK {                                   //     .
            timeout-ms = <30>;
            key-positions = <20 21>;
            bindings = <&my_TchK>;
            layers = <0>;
            require-prior-idle-ms = <150>;
        };
        combo_vopr {                                   //     ?
            timeout-ms = <30>;
            key-positions = <15 16>;
            bindings = <&my_vopr>;
            layers = <0>;
            require-prior-idle-ms = <150>;
        };
        combo_voskl {                                   //     !
            timeout-ms = <30>;
            key-positions = <14 15>;
            bindings = <&my_voskl>;
            layers = <0>;
            require-prior-idle-ms = <150>;
        };
//===   ============================
        combo_vopr {                                   //     '
            timeout-ms = <30>;
            key-positions = <27 28>;
            bindings = <&my_1kov>;
            layers = <0>;
            require-prior-idle-ms = <150>;
        };
        combo_voskl {                                   //     "
            timeout-ms = <30>;
            key-positions = <31 32>;
            bindings = <&my_2kov>;
            layers = <0>;
            require-prior-idle-ms = <150>;
        };





    };








    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp ESC         &kp Q  &kp W  &kp E      &kp R            &kp T          &kp Y              &kp U      &kp I         &kp O    &kp P      &kp LEFT_BRACKET
&kp LEFT_SHIFT  &kp A  &kp S  &kp D      &kp F            &kp G          &kp H              &kp J      &kp K         &kp L    &kp SEMI   &kp SQT
&kp TAB         &kp Z  &kp X  &kp C      &kp V            &kp B          &kp N              &kp M      &kp COMMA     &kp DOT  &kp SLASH  &mt RIGHT_ALT RIGHT_BRACKET
                              &kp LCTRL  &lt 1 BACKSPACE  &lt 2 SPACE    &mt RIGHT_GUI RET  &lt 2 DEL  &kp CAPSLOCK
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp TAB     &kp N1        &kp N2        &kp N3        &kp N4        &kp N5          &kp N6    &kp N7    &kp N8    &kp N9     &kp N0  &kp BSPC
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT  &trans  &trans
&kp LSHFT   &trans        &trans        &trans        &trans        &trans          &trans    &trans    &trans    &trans     &trans  &trans
                                        &kp LGUI      &trans        &kp SPACE       &kp RET   &trans    &kp RALT
            >;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp TAB    &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT    &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR  &kp RPAR  &kp BSPC
&kp LCTRL  &trans    &trans  &trans    &trans    &trans       &kp MINUS  &kp EQUAL  &kp LBKT   &kp RBKT  &kp BSLH  &kp GRAVE
&kp LSHFT  &trans    &trans  &trans    &trans    &trans       &kp UNDER  &kp PLUS   &kp LBRC   &kp RBRC  &kp PIPE  &kp TILDE
                             &kp LGUI  &trans    &kp SPACE    &kp RET    &trans     &kp RALT
            >;
        };
    };
};
